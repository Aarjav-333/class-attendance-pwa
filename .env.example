# Supabase project URL - Supabase Dashboard > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key - Supabase Dashboard > Project Settings > API Keys
# This key is safe to expose in the browser ONLY because Row Level Security is enabled
# on every table (see supabase/setup.sql). Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
